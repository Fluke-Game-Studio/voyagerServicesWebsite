# Copy to .env and fill in. Without MONGODB_URI the server still runs and logs
# submissions to server/data/contacts.json so the form works during development.

# MongoDB Atlas connection string (free tier works fine)
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/voyager?retryWrites=true&w=majority
MONGODB_URI=

# Port the API listens on (client dev proxy expects 5000)
PORT=5000

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
